@@ -1590,4 +1590,20 @@ var migrations = [...]func(tx *sql.Tx) error{
 		_, err = tx.Exec(sql)
 		return err
 	},
+	func(tx *sql.Tx) (err error) {
+		// user_id is the user who made the API request. It is not a foreign
+		// key so that the log outlives the users and feeds it refers to.
+		_, err = tx.Exec(`
+			CREATE TABLE audit_log (
+				id bigserial not null,
+				created_at timestamp with time zone not null default now(),
+				user_id bigint not null,
+				action text not null,
+				target_table text not null,
+				target_id bigint not null,
+				primary key (id)
+			);
+		`)
+		return err
+	},
 }
diff --git a/internal/storage/audit_log.go b/internal/storage/audit_log.go
new file mode 100644
index 00000000..0515d274
--- /dev/null
+++ b/internal/storage/audit_log.go
@@ -0,0 +1,39 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package storage // import "miniflux.app/v2/internal/storage"
+
+import (
+	"database/sql"
+	"fmt"
+)
+
+// WithAuditLog returns a Storage that appends a row to audit_log, on behalf of
+// the given user, each time it modifies a row in the users or feeds tables.
+func (s *Storage) WithAuditLog(actorID int64) *Storage {
+	return &Storage{db: s.db, auditActorID: actorID}
+}
+
+// audit appends a row to audit_log. It does nothing unless the Storage was
+// obtained from WithAuditLog.
+func (s *Storage) audit(action, table string, targetID int64) error {
+	if s.auditActorID == 0 {
+		return nil
+	}
+
+	query := `INSERT INTO audit_log (user_id, action, target_table, target_id) VALUES ($1, $2, $3, $4)`
+	if _, err := s.db.Exec(query, s.auditActorID, action, table, targetID); err != nil {
+		return fmt.Errorf(`store: unable to append audit log: %v`, err)
+	}
+
+	return nil
+}
+
+// auditIfAffected calls audit only if the given statement modified a row.
+func (s *Storage) auditIfAffected(result sql.Result, action, table string, targetID int64) error {
+	if count, err := result.RowsAffected(); err != nil || count == 0 {
+		return err
+	}
+
+	return s.audit(action, table, targetID)
+}
