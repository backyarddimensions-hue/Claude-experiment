+// EffectiveFetchTimeout returns the per-feed HTTP timeout when one is set,
+// otherwise the given global timeout.
+// @effects: pure
+func (f *Feed) EffectiveFetchTimeout(globalTimeout time.Duration) time.Duration {
+	if f.FetchTimeout > 0 {
+		return time.Duration(f.FetchTimeout) * time.Second
+	}
+	return globalTimeout
+}
