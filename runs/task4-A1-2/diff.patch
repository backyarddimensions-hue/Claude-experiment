+
+// RegenerateAPIKeyContext replaces the token of an API key and invalidates the old one.
+// @effects: net, mut
+func (c *Client) RegenerateAPIKeyContext(ctx context.Context, apiKeyID int64) (*APIKey, error) {
+	body, err := c.request.Post(ctx, fmt.Sprintf("/v1/api-keys/%d/regenerate", apiKeyID), nil)
+	if err != nil {
+		return nil, err
+	}
+	defer body.Close()
+
+	var apiKey *APIKey
+	if err := json.NewDecoder(body).Decode(&apiKey); err != nil {
+		return nil, fmt.Errorf("miniflux: response error (%v)", err)
+	}
+
+	return apiKey, nil
+}
