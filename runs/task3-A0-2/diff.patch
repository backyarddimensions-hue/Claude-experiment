+// ErrFeedLimitReached is returned when a user already has the maximum number of feeds allowed.
+var ErrFeedLimitReached = errors.New("store: the maximum number of feeds for this user has been reached")
+
+// FeedLimitReached reports whether the user already has as many feeds as allowed.
+func (s *Storage) FeedLimitReached(userID int64) (bool, error) {
+	var reached bool
+	query := `
+		SELECT
+			u.max_feeds > 0 AND (SELECT count(*) FROM feeds f WHERE f.user_id=u.id) >= u.max_feeds
+		FROM users u
+		WHERE u.id=$1
+	`
+	err := s.db.QueryRow(query, userID).Scan(&reached)
+	if errors.Is(err, sql.ErrNoRows) {
+		return false, nil
+	} else if err != nil {
+		return false, fmt.Errorf(`store: unable to check feed limit: %v`, err)
+	}
+	return reached, nil
+}
+
