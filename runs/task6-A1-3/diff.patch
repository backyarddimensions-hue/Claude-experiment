diff --git a/internal/storage/audit_log.go b/internal/storage/audit_log.go
new file mode 100644
index 00000000..4f6f69ce
--- /dev/null
+++ b/internal/storage/audit_log.go
@@ -0,0 +1,52 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package storage // import "miniflux.app/v2/internal/storage"
+
+import (
+	"database/sql"
+	"fmt"
+)
+
+// CreateAuditLog appends a row to the audit log.
+// actorID is the user who made the request, action is what happened
+// (for example "create", "update", "delete", "refresh", "import"),
+// entity is the affected table ("users" or "feeds") and entityID is the
+// affected row, or 0 when the request touched several rows.
+// @effects: writes audit_log
+func (s *Storage) CreateAuditLog(actorID int64, action, entity string, entityID int64) error {
+	var actor, target sql.NullInt64
+	if actorID > 0 {
+		actor = sql.NullInt64{Int64: actorID, Valid: true}
+	}
+	if entityID > 0 {
+		target = sql.NullInt64{Int64: entityID, Valid: true}
+	}
+
+	query := `INSERT INTO audit_log (user_id, action, entity, entity_id) VALUES ($1, $2, $3, $4)`
+	if _, err := s.db.Exec(query, actor, action, entity, target); err != nil {
+		return fmt.Errorf(`store: unable to create audit log entry: %v`, err)
+	}
+
+	return nil
+}
+
+// CountUserFeeds returns the number of feeds owned by the given user.
+// @effects: reads feeds
+func (s *Storage) CountUserFeeds(userID int64) (int, error) {
+	var count int
+	if err := s.db.QueryRow(`SELECT count(*) FROM feeds WHERE user_id=$1`, userID).Scan(&count); err != nil {
+		return 0, fmt.Errorf(`store: unable to count user feeds: %v`, err)
+	}
+	return count, nil
+}
+
+// CountCategoryFeeds returns the number of feeds in the given category.
+// @effects: reads feeds
+func (s *Storage) CountCategoryFeeds(userID, categoryID int64) (int, error) {
+	var count int
+	if err := s.db.QueryRow(`SELECT count(*) FROM feeds WHERE user_id=$1 AND category_id=$2`, userID, categoryID).Scan(&count); err != nil {
+		return 0, fmt.Errorf(`store: unable to count category feeds: %v`, err)
+	}
+	return count, nil
+}
