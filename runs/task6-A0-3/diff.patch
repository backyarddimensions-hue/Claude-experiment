+// removeCategoryAudited deletes a category and audits the feeds that are
+// removed along with it (they would otherwise be deleted by the foreign key cascade).
+func (s *Storage) removeCategoryAudited(userID, categoryID int64) error {
+	tx, err := s.db.Begin()
+	if err != nil {
+		return fmt.Errorf(`store: unable to remove this category: %v`, err)
+	}
+
+	feedIDs, err := queryIDs(tx, `DELETE FROM feeds WHERE category_id = $1 AND user_id = $2 RETURNING id`, categoryID, userID)
+	if err != nil {
+		tx.Rollback()
+		return fmt.Errorf(`store: unable to remove this category: %v`, err)
+	}
+
+	categoryIDs, err := queryIDs(tx, `DELETE FROM categories WHERE id = $1 AND user_id = $2 RETURNING id`, categoryID, userID)
+	if err != nil {
+		tx.Rollback()
+		return fmt.Errorf(`store: unable to remove this category: %v`, err)
+	}
+
+	if len(categoryIDs) == 0 {
+		tx.Rollback()
+		return errors.New(`store: no category has been removed`)
+	}
+
+	if err := s.writeAudit(tx, auditTableFeeds, auditActionDelete, feedIDs); err != nil {
+		tx.Rollback()
+		return fmt.Errorf(`store: unable to remove this category: %v`, err)
+	}
+
+	if err := tx.Commit(); err != nil {
+		return fmt.Errorf(`store: unable to remove this category: %v`, err)
+	}
+
+	return nil
+}
