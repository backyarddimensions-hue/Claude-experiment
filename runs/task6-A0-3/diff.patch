diff --git a/internal/storage/audit.go b/internal/storage/audit.go
new file mode 100644
index 00000000..54c05d30
--- /dev/null
+++ b/internal/storage/audit.go
@@ -0,0 +1,100 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package storage // import "miniflux.app/v2/internal/storage"
+
+import (
+	"database/sql"
+
+	"miniflux.app/v2/internal/model"
+
+	"github.com/lib/pq"
+)
+
+const (
+	auditTableUsers = "users"
+	auditTableFeeds = "feeds"
+
+	auditActionInsert = "insert"
+	auditActionUpdate = "update"
+	auditActionDelete = "delete"
+)
+
+// WithAudit returns a Storage sharing the same database handle that appends a
+// row to audit_log for every row of the users and feeds tables it modifies.
+// Passing nil returns a Storage that does not audit.
+func (s *Storage) WithAudit(info *model.AuditInfo) *Storage {
+	return &Storage{db: s.db, audit: info}
+}
+
+// writeAudit appends one audit_log row per modified row ID. It is a no-op
+// when the Storage is not auditing.
+func (s *Storage) writeAudit(tx *sql.Tx, table, action string, ids []int64) error {
+	if s.audit == nil || len(ids) == 0 {
+		return nil
+	}
+
+	actor := sql.NullInt64{Int64: s.audit.UserID, Valid: s.audit.UserID != 0}
+	_, err := tx.Exec(
+		`
+		INSERT INTO audit_log
+			(actor_user_id, request_method, request_path, table_name, action, row_id)
+		SELECT
+			$1, $2, $3, $4, $5, unnest($6::bigint[])
+		`,
+		actor,
+		s.audit.Method,
+		s.audit.Path,
+		table,
+		action,
+		pq.Array(ids),
+	)
+	return err
+}
+
+// queryIDs runs a query returning a single bigint column and collects it.
+func queryIDs(tx *sql.Tx, query string, args ...any) ([]int64, error) {
+	rows, err := tx.Query(query, args...)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+
+	var ids []int64
+	for rows.Next() {
+		var id int64
+		if err := rows.Scan(&id); err != nil {
+			return nil, err
+		}
+		ids = append(ids, id)
+	}
+	return ids, rows.Err()
+}
+
+// execAudited executes a statement modifying rows of the given table. When
+// the Storage is auditing, the statement and the audit rows are written in
+// the same transaction. The query must not have a RETURNING clause.
+func (s *Storage) execAudited(table, action, query string, args ...any) error {
+	if s.audit == nil {
+		_, err := s.db.Exec(query, args...)
+		return err
+	}
+
+	tx, err := s.db.Begin()
+	if err != nil {
+		return err
+	}
+
+	ids, err := queryIDs(tx, query+" RETURNING id", args...)
+	if err != nil {
+		tx.Rollback()
+		return err
+	}
+
+	if err := s.writeAudit(tx, table, action, ids); err != nil {
+		tx.Rollback()
+		return err
+	}
+
+	return tx.Commit()
+}
