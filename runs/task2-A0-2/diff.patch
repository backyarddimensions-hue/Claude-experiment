+// setEntryWordCount computes the number of words of the entry content
+// (HTML tags removed) and stores it on the entry.
+func setEntryWordCount(entry *model.Entry) int {
+	count := len(strings.Fields(sanitizer.StripTags(entry.Content)))
+	entry.WordCount = &count
+	return count
+}
