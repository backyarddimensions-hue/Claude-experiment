+// ErrFeedLimitReached is returned when a user already has the maximum number of feeds allowed.
+var ErrFeedLimitReached = errors.New("store: the maximum number of feeds for this user has been reached")
+
+type feedLimitQuerier interface {
+	QueryRow(query string, args ...any) *sql.Row
+}
+
+// @effects: reads feeds, reads users
+func feedLimitReached(q feedLimitQuerier, userID int64, lock bool) (bool, error) {
+	query := `SELECT max_feeds FROM users WHERE id=$1`
+	if lock {
+		query += ` FOR NO KEY UPDATE`
+	}
+
+	var maxFeeds int
+	err := q.QueryRow(query, userID).Scan(&maxFeeds)
+	if errors.Is(err, sql.ErrNoRows) {
+		return false, nil
+	} else if err != nil {
+		return false, fmt.Errorf(`store: unable to fetch user feed limit: %v`, err)
+	}
+
+	if maxFeeds <= 0 {
+		return false, nil
+	}
+
+	var count int
+	if err := q.QueryRow(`SELECT count(*) FROM feeds WHERE user_id=$1`, userID).Scan(&count); err != nil {
+		return false, fmt.Errorf(`store: unable to count user feeds: %v`, err)
+	}
+
+	return count >= maxFeeds, nil
+}
+
+// FeedLimitReached returns true if the user already has the maximum number of feeds allowed.
+// @effects: reads feeds, reads users
+func (s *Storage) FeedLimitReached(userID int64) (bool, error) {
+	return feedLimitReached(s.db, userID, false)
+}
