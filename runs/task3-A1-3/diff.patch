+// SetUserMaxFeeds sets the maximum number of feeds the user may have; 0 means unlimited.
+// UpdateUser deliberately does not write this column, so that only this
+// administrator-only path can change it.
+// @effects: writes users
+func (s *Storage) SetUserMaxFeeds(userID int64, maxFeeds int) error {
+	if maxFeeds < 0 {
+		return fmt.Errorf(`store: invalid feed limit: %d`, maxFeeds)
+	}
+	if _, err := s.db.Exec(`UPDATE users SET max_feeds=$1 WHERE id=$2`, maxFeeds, userID); err != nil {
+		return fmt.Errorf(`store: unable to update user feed limit: %v`, err)
+	}
+	return nil
+}
+
+// FeedLimitReached returns true if the user has a feed limit and already has that many feeds.
+// @effects: reads feeds, reads users
+func (s *Storage) FeedLimitReached(userID int64) (bool, error) {
+	var reached bool
+	query := `
+		SELECT
+			u.max_feeds > 0 AND (SELECT count(*) FROM feeds f WHERE f.user_id=u.id) >= u.max_feeds
+		FROM
+			users u
+		WHERE
+			u.id=$1
+	`
+	err := s.db.QueryRow(query, userID).Scan(&reached)
+	if errors.Is(err, sql.ErrNoRows) {
+		return false, nil
+	} else if err != nil {
+		return false, fmt.Errorf(`store: unable to check user feed limit: %v`, err)
+	}
+	return reached, nil
+}
