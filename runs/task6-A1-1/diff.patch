diff --git a/internal/storage/audit_log.go b/internal/storage/audit_log.go
new file mode 100644
index 00000000..775d4585
--- /dev/null
+++ b/internal/storage/audit_log.go
@@ -0,0 +1,58 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package storage // import "miniflux.app/v2/internal/storage"
+
+import (
+	"fmt"
+)
+
+// Audit log actions.
+const (
+	AuditActionCreate  = "create"
+	AuditActionUpdate  = "update"
+	AuditActionDelete  = "delete"
+	AuditActionRefresh = "refresh"
+)
+
+// Audit log table names.
+const (
+	AuditTableUsers = "users"
+	AuditTableFeeds = "feeds"
+)
+
+// CreateAuditLog appends a row to the audit log.
+//
+// userID is the user who made the request, tableName is the modified table and
+// rowID the modified row (0 when the request affects several or unknown rows).
+// @effects: writes audit_log
+func (s *Storage) CreateAuditLog(userID int64, action, tableName string, rowID int64) error {
+	query := `INSERT INTO audit_log (user_id, action, table_name, row_id) VALUES (NULLIF($1, 0), $2, $3, NULLIF($4, 0))`
+	if _, err := s.db.Exec(query, userID, action, tableName, rowID); err != nil {
+		return fmt.Errorf(`store: unable to append audit log entry (%s %s #%d): %v`, action, tableName, rowID, err)
+	}
+	return nil
+}
+
+// CategoryFeedIDs returns the IDs of the feeds that belong to the given category.
+// @effects: reads feeds
+func (s *Storage) CategoryFeedIDs(userID, categoryID int64) ([]int64, error) {
+	rows, err := s.db.Query(`SELECT id FROM feeds WHERE user_id=$1 AND category_id=$2`, userID, categoryID)
+	if err != nil {
+		return nil, fmt.Errorf(`store: unable to fetch category feed IDs: %v`, err)
+	}
+	defer rows.Close()
+
+	var feedIDs []int64
+	for rows.Next() {
+		var feedID int64
+		if err := rows.Scan(&feedID); err != nil {
