 // ScheduleNextCheck set "next_check_at" of a feed based on the scheduler selected from the configuration.
 // @effects: mut
 func (f *Feed) ScheduleNextCheck(weeklyCount int, refreshDelay time.Duration) time.Duration {
+	// A per-feed interval overrides the global scheduler interval and its limits.
+	// Delays requested by the server (Retry-After, TTL, Cache-Control, Expires) are still honored.
+	if f.RefreshInterval > 0 {
+		feedInterval := max(time.Duration(f.RefreshInterval)*time.Minute, refreshDelay)
+		f.NextCheckAt = time.Now().Add(feedInterval)
