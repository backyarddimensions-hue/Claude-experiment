+// SetRefreshInterval changes the per-feed polling interval (in minutes, 0 means "use the global interval").
+// When a new interval is set, the next check is brought forward if it is further away than that interval.
+// @effects: mut
+func (f *Feed) SetRefreshInterval(minutes int) {
+	minutes = max(minutes, 0)
+	if minutes == f.RefreshInterval {
+		return
+	}
+	f.RefreshInterval = minutes
+	if minutes > 0 && !f.NextCheckAt.IsZero() {
+		if next := time.Now().Add(time.Duration(minutes) * time.Minute); next.Before(f.NextCheckAt) {
+			f.NextCheckAt = next
+		}
+	}
