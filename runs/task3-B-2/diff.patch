+
+// FeedLimitReached reports whether the user already has as many feeds as allowed (0 means unlimited).
+// @effects: reads feeds, reads users
+func (s *Storage) FeedLimitReached(userID int64) (bool, error) {
+	var reached bool
+	query := `
+		SELECT
+			u.max_feeds > 0 AND (SELECT count(*) FROM feeds f WHERE f.user_id=u.id) >= u.max_feeds
+		FROM
+			users u
+		WHERE
+			u.id=$1
+	`
+	if err := s.db.QueryRow(query, userID).Scan(&reached); err != nil {
+		if errors.Is(err, sql.ErrNoRows) {
+			return false, nil
+		}
+		return false, fmt.Errorf(`store: unable to check feed limit of user #%d: %v`, userID, err)
+	}
+	return reached, nil
+}
