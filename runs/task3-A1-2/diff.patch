+// ErrFeedLimitReached is returned when a user already has the maximum number of feeds allowed.
+var ErrFeedLimitReached = errors.New("store: the maximum number of feeds allowed for this user has been reached")
+
+// checkUserFeedLimit locks the user row, so that concurrent feed creations for
+// the same user are serialized, and returns ErrFeedLimitReached if the user
+// cannot have one more feed.
+// @effects: reads feeds, reads users
+func checkUserFeedLimit(tx *sql.Tx, userID int64) error {
+	var maxFeeds int
+	err := tx.QueryRow(`SELECT max_feeds FROM users WHERE id=$1 FOR NO KEY UPDATE`, userID).Scan(&maxFeeds)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil
+	} else if err != nil {
+		return fmt.Errorf(`store: unable to fetch user feed limit: %v`, err)
+	}
+
+	if maxFeeds <= 0 {
+		return nil
+	}
+
+	var count int
+	if err := tx.QueryRow(`SELECT count(*) FROM feeds WHERE user_id=$1`, userID).Scan(&count); err != nil {
+		return fmt.Errorf(`store: unable to count user feeds: %v`, err)
+	}
+
+	if count >= maxFeeds {
+		return ErrFeedLimitReached
+	}
+	return nil
+}
