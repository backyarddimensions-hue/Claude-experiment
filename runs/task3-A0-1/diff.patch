+// SetUserMaxFeeds sets the maximum number of feeds allowed for the given user (0 means unlimited).
+// UpdateUser deliberately never writes this column, so only this method can change it.
+func (s *Storage) SetUserMaxFeeds(userID int64, maxFeeds int) error {
+	if _, err := s.db.Exec(`UPDATE users SET max_feeds=$1 WHERE id=$2`, maxFeeds, userID); err != nil {
+		return fmt.Errorf(`store: unable to update user feed limit: %v`, err)
+	}
+	return nil
+}
+
+// FeedLimitReached returns true if the given user cannot create any more feeds.
+func (s *Storage) FeedLimitReached(userID int64) (bool, error) {
+	var reached bool
+	query := `
+		SELECT
+			u.max_feeds > 0 AND (SELECT count(*) FROM feeds f WHERE f.user_id=u.id) >= u.max_feeds
+		FROM
+			users u
+		WHERE
+			u.id=$1
+	`
+	err := s.db.QueryRow(query, userID).Scan(&reached)
+	if errors.Is(err, sql.ErrNoRows) {
+		return false, nil
+	} else if err != nil {
+		return false, fmt.Errorf(`store: unable to check user feed limit: %v`, err)
+	}
+	return reached, nil
+}
