diff --git a/internal/storage/audit_log.go b/internal/storage/audit_log.go
new file mode 100644
index 00000000..c10bcc6d
--- /dev/null
+++ b/internal/storage/audit_log.go
@@ -0,0 +1,43 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package storage // import "miniflux.app/v2/internal/storage"
+
+import (
+	"database/sql"
+	"errors"
+	"fmt"
+)
+
+// Names of the tables covered by the audit log.
+const (
+	AuditTableUsers = "users"
+	AuditTableFeeds = "feeds"
+)
+
+// CreateAuditLog appends a row to the audit log.
+//
+// userID is the user who made the API request, tableName is the modified table
+// and rowID is the affected row (0 when the request affects several rows).
+// @effects: writes audit_log
+func (s *Storage) CreateAuditLog(userID int64, action, tableName string, rowID int64) error {
+	query := `INSERT INTO audit_log (user_id, action, table_name, row_id) VALUES ($1, $2, $3, $4)`
+	if _, err := s.db.Exec(query, userID, action, tableName, rowID); err != nil {
+		return fmt.Errorf(`store: unable to append to the audit log: %v`, err)
+	}
+	return nil
+}
+
+// CategoryHasFeeds reports whether the given category contains at least one feed.
+// @effects: reads feeds
+func (s *Storage) CategoryHasFeeds(userID, categoryID int64) (bool, error) {
+	var result bool
+	query := `SELECT true FROM feeds WHERE user_id=$1 AND category_id=$2 LIMIT 1`
+	if err := s.db.QueryRow(query, userID, categoryID).Scan(&result); err != nil {
+		if errors.Is(err, sql.ErrNoRows) {
+			return false, nil
+		}
+		return false, fmt.Errorf(`store: unable to check if the category has feeds: %v`, err)
+	}
+	return result, nil
+}
