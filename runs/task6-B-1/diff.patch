diff --git a/internal/storage/audit_log.go b/internal/storage/audit_log.go
new file mode 100644
index 00000000..7fefd4a5
--- /dev/null
+++ b/internal/storage/audit_log.go
@@ -0,0 +1,59 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package storage // import "miniflux.app/v2/internal/storage"
+
+import (
+	"fmt"
+)
+
+// Audit log table names and actions.
+const (
+	AuditTableUsers = "users"
+	AuditTableFeeds = "feeds"
+
+	AuditActionCreate  = "create"
+	AuditActionUpdate  = "update"
+	AuditActionRemove  = "remove"
+	AuditActionRefresh = "refresh"
+	AuditActionImport  = "import"
+)
+
+// AppendAuditLog appends a row to the audit log.
+//
+// userID is the user who made the request, tableName is the modified table,
+// action describes the modification and rowID is the modified row
+// (0 when the request touched several rows).
+// @effects: writes audit_log
+func (s *Storage) AppendAuditLog(userID int64, tableName, action string, rowID int64) error {
+	query := `
+		INSERT INTO audit_log
+			(user_id, table_name, action, row_id)
+		VALUES
+			($1, $2, $3, $4)
+	`
+	if _, err := s.db.Exec(query, userID, tableName, action, rowID); err != nil {
+		return fmt.Errorf(`store: unable to append audit log entry: %v`, err)
+	}
+	return nil
+}
+
+// CountAuditLogEntries returns the number of rows in the audit log.
+// @effects: reads audit_log
+func (s *Storage) CountAuditLogEntries() (int, error) {
+	var count int
+	if err := s.db.QueryRow(`SELECT count(*) FROM audit_log`).Scan(&count); err != nil {
+		return 0, fmt.Errorf(`store: unable to count audit log entries: %v`, err)
+	}
+	return count, nil
+}
+
+// CountUserFeeds returns the number of feeds owned by the given user.
+// @effects: reads feeds
+func (s *Storage) CountUserFeeds(userID int64) (int, error) {
+	var count int
+	if err := s.db.QueryRow(`SELECT count(*) FROM feeds WHERE user_id=$1`, userID).Scan(&count); err != nil {
+		return 0, fmt.Errorf(`store: unable to count feeds: %v`, err)
+	}
+	return count, nil
+}
