+
+import (
+	"fmt"
+
+	"github.com/lib/pq"
+)
+
+// Audit log actions and table names.
+const (
+	AuditActionCreate = "create"
+	AuditActionUpdate = "update"
+	AuditActionDelete = "delete"
+
+	AuditTableUsers = "users"
+	AuditTableFeeds = "feeds"
+)
+
+// AppendAuditLog appends one audit_log row per given row ID, recording that
+// actorUserID performed the action on the given table.
+// @effects: writes audit_log
+func (s *Storage) AppendAuditLog(actorUserID int64, action, tableName string, rowIDs ...int64) error {
+	if len(rowIDs) == 0 {
+		return nil
+	}
+
+	query := `
+		INSERT INTO audit_log
+			(user_id, action, table_name, row_id)
+		SELECT
+			$1, $2, $3, unnest($4::bigint[])
+	`
+	if _, err := s.db.Exec(query, actorUserID, action, tableName, pq.Array(rowIDs)); err != nil {
+		return fmt.Errorf(`store: unable to append audit log for %s (%s): %v`, tableName, action, err)
+	}
+
+	return nil
+}
