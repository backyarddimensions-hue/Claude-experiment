+// HTTPClientTimeout returns the per-feed HTTP timeout if defined, otherwise the given global timeout.
+// @effects: pure
+func (f *Feed) HTTPClientTimeout(globalTimeout time.Duration) time.Duration {
+	if f.FetchTimeout > 0 {
+		return time.Duration(f.FetchTimeout) * time.Second
+	}
