 func (s *Storage) SetLastLogin(userID int64) error {
-	query := `UPDATE users SET last_login_at=now() WHERE id=$1`
-	_, err := s.db.Exec(query, userID)
+	tx, err := s.db.Begin()
 	if err != nil {
+		return fmt.Errorf(`store: unable to start transaction: %v`, err)
