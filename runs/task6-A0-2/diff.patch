+	if _, err := tx.Exec(`SELECT set_config('miniflux.skip_audit', 'on', true)`); err != nil {
+		tx.Rollback()
+		return fmt.Errorf(`store: unable to update last login date: %v`, err)
+	}
+
+	if _, err := tx.Exec(`UPDATE users SET last_login_at=now() WHERE id=$1`, userID); err != nil {
+		tx.Rollback()
+		return fmt.Errorf(`store: unable to update last login date: %v`, err)
+	}
+
+	if err := tx.Commit(); err != nil {
 		return fmt.Errorf(`store: unable to update last login date: %v`, err)
 	}
 
