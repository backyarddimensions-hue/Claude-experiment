+func (h *handler) getFeedEntriesCountHandler(w http.ResponseWriter, r *http.Request) {
+	feedID := request.RouteInt64Param(r, "feedID")
+	if feedID <= 0 {
+		response.JSONNotFound(w, r)
+		return
+	}
+
+	userID := request.UserID(r)
+	exists, err := h.store.FeedExists(userID, feedID)
+	if err != nil {
+		response.JSONServerError(w, r, err)
+		return
+	}
+	if !exists {
+		response.JSONNotFound(w, r)
+		return
+	}
+
+	count, err := h.store.NewEntryQueryBuilder(userID).WithFeedID(feedID).CountEntries()
+	if err != nil {
+		response.JSONServerError(w, r, err)
+		return
+	}
+
+	response.JSON(w, r, map[string]int{"count": count})
+}
