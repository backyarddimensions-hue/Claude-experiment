diff --git a/internal/storage/audit.go b/internal/storage/audit.go
new file mode 100644
index 00000000..1c44d180
--- /dev/null
+++ b/internal/storage/audit.go
@@ -0,0 +1,82 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package storage // import "miniflux.app/v2/internal/storage"
+
+import (
+	"database/sql"
+	"fmt"
+)
+
+// Audit log actions.
+const (
+	auditActionCreate = "create"
+	auditActionUpdate = "update"
+	auditActionDelete = "delete"
+)
+
+// auditContext describes the API request on whose behalf rows are modified.
+type auditContext struct {
+	actorUserID int64
+	request     string
+}
+
+// WithAudit returns a Storage that shares the same database handle but appends
+// a row to audit_log, atomically with the change, for every row of the users
+// and feeds tables that it inserts, updates or deletes.
+//
+// SetLastLogin is deliberately never audited.
+func (s *Storage) WithAudit(actorUserID int64, request string) *Storage {
+	return &Storage{db: s.db, audit: &auditContext{actorUserID: actorUserID, request: request}}
+}
+
+// audited wraps a data-modifying query, which must end with a RETURNING clause
+// exposing the "id" column, so that the same statement also writes one
+// audit_log row per affected row. The wrapped query returns the same columns
+// as the original one. Without an audit context the query is returned as is.
+func (s *Storage) audited(table, action, query string, args ...any) (string, []any) {
+	if s.audit == nil {
+		return query, args
+	}
+
+	n := len(args)
+	wrapped := fmt.Sprintf(`
+		WITH changed AS (
+			%s
+		), audited AS (
+			INSERT INTO audit_log
+				(actor_user_id, request, table_name, row_id, action)
+			SELECT
+				$%d::bigint, $%d::text, $%d::text, changed.id, $%d::text
+			FROM
+				changed
+		)
+		SELECT * FROM changed
+	`, query, n+1, n+2, n+3, n+4)
+
+	return wrapped, append(args[:n:n], s.audit.actorUserID, s.audit.request, table, action)
+}
+
+// auditRows writes, inside the given transaction, one audit_log row per ID
+// returned by selectIDs (a query exposing an "id" column). It does nothing
+// without an audit context.
+func (s *Storage) auditRows(tx *sql.Tx, table, action, selectIDs string, args ...any) error {
+	if s.audit == nil {
+		return nil
+	}
+
+	n := len(args)
+	query := fmt.Sprintf(`
+		INSERT INTO audit_log
+			(actor_user_id, request, table_name, row_id, action)
+		SELECT
+			$%d::bigint, $%d::text, $%d::text, affected.id, $%d::text
+		FROM
+			(%s) AS affected
+	`, n+1, n+2, n+3, n+4, selectIDs)
+
+	if _, err := tx.Exec(query, append(args[:n:n], s.audit.actorUserID, s.audit.request, table, action)...); err != nil {
+		return fmt.Errorf(`store: unable to write audit log: %v`, err)
+	}
+	return nil
+}
