diff --git a/internal/storage/audit.go b/internal/storage/audit.go
new file mode 100644
index 00000000..1a1be311
--- /dev/null
+++ b/internal/storage/audit.go
@@ -0,0 +1,46 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package storage // import "miniflux.app/v2/internal/storage"
+
+import (
+	"database/sql"
+	"fmt"
+)
+
+// AppendAuditLog appends a row to the audit log.
+//
+// userID is the user who made the request, action describes the operation
+// (for example "create", "update", "delete"), tableName is the modified table
+// and rowID is the modified row (0 when the request touched several rows).
+// @effects: writes audit_log
+func (s *Storage) AppendAuditLog(userID int64, action, tableName string, rowID int64) error {
+	var actor, row sql.NullInt64
+	if userID != 0 {
+		actor = sql.NullInt64{Int64: userID, Valid: true}
+	}
+	if rowID != 0 {
+		row = sql.NullInt64{Int64: rowID, Valid: true}
+	}
+
+	query := `INSERT INTO audit_log (user_id, action, table_name, row_id) VALUES ($1, $2, $3, $4)`
+	if _, err := s.db.Exec(query, actor, action, tableName, row); err != nil {
+		return fmt.Errorf(`store: unable to append audit log: %v`, err)
+	}
+
+	return nil
+}
+
+// AuditFeedCount returns the number of feeds owned by the user, restricted to
+// the given category when categoryID is not 0. It is used to decide whether a
+// request modified the feeds table indirectly.
+// @effects: reads feeds
+func (s *Storage) AuditFeedCount(userID, categoryID int64) (int, error) {
+	var count int
+	query := `SELECT count(*) FROM feeds WHERE user_id=$1 AND ($2::bigint = 0 OR category_id = $2::bigint)`
+	if err := s.db.QueryRow(query, userID, categoryID).Scan(&count); err != nil {
+		return 0, fmt.Errorf(`store: unable to count feeds: %v`, err)
+	}
+
+	return count, nil
+}
