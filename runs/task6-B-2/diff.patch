+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package api // import "miniflux.app/v2/internal/api"
+
+import (
+	"net/http"
+
+	"miniflux.app/v2/internal/http/request"
+	"miniflux.app/v2/internal/http/response"
+)
+
+// audit appends a row to audit_log for the current request. Every API request
+// that modifies a row in users or feeds must call it. It writes a server error
+// and returns false when the row cannot be appended.
+// @effects: writes audit_log
+func (h *handler) audit(w http.ResponseWriter, r *http.Request, action, tableName string, rowID int64) bool {
+	if err := h.store.AppendAuditLog(request.UserID(r), action, tableName, rowID); err != nil {
+		response.JSONServerError(w, r, err)
+		return false
+	}
+	return true
+}
